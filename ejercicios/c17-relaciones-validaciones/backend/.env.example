# Copiar a backend/.env y completar con valores reales.
# backend/.env esta en .gitignore: no se sube al repo.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Credenciales del contenedor de Postgres
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=libreria_db
POSTGRES_PORT=5432

# Conexion que usan Prisma y el backend.
# El host es "db" porque es el nombre del servicio en docker-compose.yml.
DATABASE_URL=postgresql://tu_usuario:tu_password_segura@db:5432/libreria_db
